#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "$0")")"
ROOT_DIR="$SCRIPT_DIR/.."
DOCKER_DIR="$ROOT_DIR/docker"
RELEASE_TEMPLATE_DIR="$DOCKER_DIR/release"
RELEASE_ROOT="${RELEASE_ROOT:-$ROOT_DIR/release}"
IMAGE_NAMESPACE="${IMAGE_NAMESPACE:-dify-custom}"

BASE_VERSION="$(sed -n 's/.*langgenius\/dify-api:\(.*\)$/\1/p' "$DOCKER_DIR/docker-compose.yaml" | head -n 1)"
COMMIT_SHA="$(git -C "$ROOT_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)"
BUILD_DATE="$(date -u +%Y%m%d)"
BUILD_TIME_UTC="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
VERSION="${1:-${BASE_VERSION}-${BUILD_DATE}-${COMMIT_SHA}}"

API_IMAGE="${API_IMAGE:-${IMAGE_NAMESPACE}-api:${VERSION}}"
WEB_IMAGE="${WEB_IMAGE:-${IMAGE_NAMESPACE}-web:${VERSION}}"

RELEASE_DIR="$RELEASE_ROOT/$VERSION"
COMPOSE_DIR="$RELEASE_DIR/compose"
SCRIPTS_DIR="$RELEASE_DIR/scripts"
IMAGES_ARCHIVE="$RELEASE_DIR/images.tar"
IMAGES_ARCHIVE_GZ="$IMAGES_ARCHIVE.gz"
MANIFEST_PATH="$RELEASE_DIR/manifest.json"

THIRD_PARTY_IMAGES=(
  "postgres:15-alpine"
  "redis:6-alpine"
  "langgenius/dify-sandbox:0.2.12"
  "langgenius/dify-plugin-daemon:0.3.0b1-local"
  "ubuntu/squid:latest"
  "certbot/certbot"
  "nginx:latest"
  "semitechnologies/weaviate:1.19.0"
)

ALL_IMAGES=("$API_IMAGE" "$WEB_IMAGE" "${THIRD_PARTY_IMAGES[@]}")

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command not found: $1"
    exit 1
  fi
}

render_override_compose() {
  sed \
    -e "s|__DIFY_RELEASE_API_IMAGE__|$API_IMAGE|g" \
    -e "s|__DIFY_RELEASE_WEB_IMAGE__|$WEB_IMAGE|g" \
    "$DOCKER_DIR/docker-compose.production.override.yaml" \
    > "$COMPOSE_DIR/docker-compose.production.override.yaml"
}

write_manifest() {
  {
    echo "{"
    echo "  \"version\": \"$VERSION\","
    echo "  \"commit_sha\": \"$COMMIT_SHA\","
    echo "  \"built_at_utc\": \"$BUILD_TIME_UTC\","
    echo "  \"images\": {"
    echo "    \"api\": \"$API_IMAGE\","
    echo "    \"web\": \"$WEB_IMAGE\""
    echo "  },"
    echo "  \"third_party_images\": ["
    for i in "${!THIRD_PARTY_IMAGES[@]}"; do
      suffix=","
      if [ "$i" -eq "$((${#THIRD_PARTY_IMAGES[@]} - 1))" ]; then
        suffix=""
      fi
      echo "    \"${THIRD_PARTY_IMAGES[$i]}\"$suffix"
    done
    echo "  ],"
    echo "  \"compose_files\": ["
    echo "    \"compose/docker-compose.yaml\","
    echo "    \"compose/docker-compose.production.override.yaml\""
    echo "  ],"
    echo "  \"env_template\": \"compose/.env.production.example\","
    echo "  \"image_archive\": \"images.tar.gz\""
    echo "}"
  } > "$MANIFEST_PATH"
}

ensure_volume_dirs() {
  mkdir -p "$COMPOSE_DIR/volumes/app/storage"
  mkdir -p "$COMPOSE_DIR/volumes/db/data"
  mkdir -p "$COMPOSE_DIR/volumes/redis/data"
  mkdir -p "$COMPOSE_DIR/volumes/sandbox/dependencies"
  mkdir -p "$COMPOSE_DIR/volumes/sandbox/conf"
  mkdir -p "$COMPOSE_DIR/volumes/plugin_daemon"
  mkdir -p "$COMPOSE_DIR/volumes/certbot/conf/live"
  mkdir -p "$COMPOSE_DIR/volumes/certbot/conf"
  mkdir -p "$COMPOSE_DIR/volumes/certbot/www"
  mkdir -p "$COMPOSE_DIR/volumes/certbot/logs"
  mkdir -p "$COMPOSE_DIR/volumes/weaviate"
}

write_checksums() {
  (
    cd "$RELEASE_DIR"
    if command -v sha256sum >/dev/null 2>&1; then
      find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS
    elif command -v shasum >/dev/null 2>&1; then
      find . -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 shasum -a 256 > SHA256SUMS
    else
      echo "No sha256 checksum tool found, skipping SHA256SUMS generation"
    fi
  )
}

require_command docker
require_command git
require_command sed
require_command gzip
require_command cp
require_command find
require_command xargs

echo "Building custom API image: $API_IMAGE"
docker build \
  --build-arg COMMIT_SHA="$COMMIT_SHA" \
  -t "$API_IMAGE" \
  -f "$ROOT_DIR/api/Dockerfile" \
  "$ROOT_DIR/api"

echo "Building custom web image: $WEB_IMAGE"
docker build \
  --build-arg COMMIT_SHA="$COMMIT_SHA" \
  -t "$WEB_IMAGE" \
  -f "$ROOT_DIR/web/Dockerfile" \
  "$ROOT_DIR/web"

for image in "${THIRD_PARTY_IMAGES[@]}"; do
  echo "Pulling dependency image: $image"
  docker pull "$image"
done

rm -rf "$RELEASE_DIR"
mkdir -p "$COMPOSE_DIR" "$SCRIPTS_DIR"

cp "$DOCKER_DIR/docker-compose.yaml" "$COMPOSE_DIR/docker-compose.yaml"
render_override_compose
cp "$DOCKER_DIR/.env.production.example" "$COMPOSE_DIR/.env.production.example"
cp -R "$DOCKER_DIR/nginx" "$COMPOSE_DIR/nginx"
cp -R "$DOCKER_DIR/ssrf_proxy" "$COMPOSE_DIR/ssrf_proxy"
mkdir -p "$COMPOSE_DIR/certbot"
cp "$DOCKER_DIR/certbot/docker-entrypoint.sh" "$COMPOSE_DIR/certbot/docker-entrypoint.sh"
cp "$DOCKER_DIR/certbot/update-cert.template.txt" "$COMPOSE_DIR/certbot/update-cert.template.txt"
cp "$RELEASE_TEMPLATE_DIR/load-images.sh" "$SCRIPTS_DIR/load-images.sh"
cp "$RELEASE_TEMPLATE_DIR/deploy.sh" "$SCRIPTS_DIR/deploy.sh"
chmod +x "$SCRIPTS_DIR/load-images.sh" "$SCRIPTS_DIR/deploy.sh"

ensure_volume_dirs
write_manifest

cp "$COMPOSE_DIR/.env.production.example" "$COMPOSE_DIR/.env"
(
  cd "$COMPOSE_DIR"
  docker compose \
    -p dify-release-validate \
    --env-file .env \
    -f docker-compose.yaml \
    -f docker-compose.production.override.yaml \
    config -q
)
rm -f "$COMPOSE_DIR/.env"

echo "Saving release images to $IMAGES_ARCHIVE_GZ"
docker save -o "$IMAGES_ARCHIVE" "${ALL_IMAGES[@]}"
gzip -f "$IMAGES_ARCHIVE"

write_checksums

echo
echo "Release bundle created:"
echo "  $RELEASE_DIR"
echo "Images:"
echo "  $API_IMAGE"
echo "  $WEB_IMAGE"
