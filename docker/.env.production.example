# External access URLs
CONSOLE_API_URL=https://your-domain.example
CONSOLE_WEB_URL=https://your-domain.example
SERVICE_API_URL=http://api:5001
APP_API_URL=https://your-domain.example
APP_WEB_URL=https://your-domain.example
FILES_URL=https://your-domain.example
INTERNAL_FILES_URL=http://api:5001

# Core runtime
SECRET_KEY=replace-me-with-openssl-rand-base64-42
LOG_LEVEL=INFO
DEBUG=false
FLASK_DEBUG=false
MIGRATION_ENABLED=true
DIFY_BIND_ADDRESS=0.0.0.0
DIFY_PORT=5001
SERVER_WORKER_AMOUNT=1
SERVER_WORKER_CLASS=gevent
SERVER_WORKER_CONNECTIONS=10
GUNICORN_TIMEOUT=360
CELERY_WORKER_AMOUNT=1

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me-db-password
POSTGRES_DB=dify
DB_USERNAME=postgres
DB_PASSWORD=replace-me-db-password
DB_HOST=db
DB_PORT=5432
DB_DATABASE=dify
SQLALCHEMY_POOL_PRE_PING=true

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-me-redis-password
REDIS_USE_SSL=false
REDIS_SSL_CERT_REQS=CERT_NONE
REDIS_DB=0
CELERY_BROKER_URL=redis://:replace-me-redis-password@redis:6379/1
CELERY_BACKEND=redis

# Storage
STORAGE_TYPE=opendal
OPENDAL_SCHEME=fs
OPENDAL_FS_ROOT=storage

# Default vector store
VECTOR_STORE=weaviate
VECTOR_INDEX_NAME_PREFIX=Vector_index
WEAVIATE_ENDPOINT=http://weaviate:8080
WEAVIATE_API_KEY=replace-me-weaviate-api-key
WEAVIATE_GRPC_ENABLED=false
WEAVIATE_BATCH_SIZE=100

# Sandbox and plugin daemon
CODE_EXECUTION_ENDPOINT=http://sandbox:8194
CODE_EXECUTION_API_KEY=replace-me-sandbox-api-key
SANDBOX_API_KEY=replace-me-sandbox-api-key
PLUGIN_DAEMON_URL=http://plugin_daemon:5002
PLUGIN_DAEMON_KEY=replace-me-plugin-daemon-key
PLUGIN_DIFY_INNER_API_KEY=replace-me-inner-api-key
PLUGIN_DIFY_INNER_API_URL=http://api:5001

# Web runtime
NEXT_TELEMETRY_DISABLED=1
SENTRY_DSN=
TEXT_GENERATION_TIMEOUT_MS=60000
CSP_WHITELIST=
ALLOW_EMBED=false
ALLOW_UNSAFE_DATA_SCHEME=false
MARKETPLACE_API_URL=https://marketplace.dify.ai
MARKETPLACE_URL=https://marketplace.dify.ai
TOP_K_MAX_VALUE=10
INDEXING_MAX_SEGMENTATION_TOKENS_LENGTH=4000
PM2_INSTANCES=2
LOOP_NODE_MAX_COUNT=100
MAX_TOOLS_NUM=10
MAX_PARALLEL_LIMIT=10
MAX_ITERATIONS_NUM=99
MAX_TREE_DEPTH=50
ENABLE_WEBSITE_JINAREADER=true
ENABLE_WEBSITE_FIRECRAWL=true
ENABLE_WEBSITE_WATERCRAWL=true

# Reverse proxy
NGINX_SERVER_NAME=your-domain.example
NGINX_HTTPS_ENABLED=false
NGINX_PORT=80
NGINX_SSL_PORT=443
NGINX_SSL_CERT_FILENAME=dify.crt
NGINX_SSL_CERT_KEY_FILENAME=dify.key
NGINX_SSL_PROTOCOLS=TLSv1.2 TLSv1.3
NGINX_WORKER_PROCESSES=auto
NGINX_CLIENT_MAX_BODY_SIZE=100M
NGINX_KEEPALIVE_TIMEOUT=65
NGINX_PROXY_READ_TIMEOUT=3600s
NGINX_PROXY_SEND_TIMEOUT=3600s
NGINX_ENABLE_CERTBOT_CHALLENGE=false
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443
WEB_API_CORS_ALLOW_ORIGINS=https://your-domain.example
CONSOLE_CORS_ALLOW_ORIGINS=https://your-domain.example

# Optional certbot profile
CERTBOT_EMAIL=
CERTBOT_DOMAIN=
CERTBOT_OPTIONS=
